# Copy to .env and fill in your provider credentials.
#   cp .env.example .env
#
# Claude Code reads ANTHROPIC_* when invoking models during aixploit runs.

# --- Anthropic (direct) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenRouter ---
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=sk-or-v1-...

# --- Corporate proxy (example shape only; use your org's endpoint) ---
# ANTHROPIC_BASE_URL=https://api.example.com/aiendpoint/
# ANTHROPIC_AUTH_TOKEN=<your-token>
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-20250514
# DISABLE_NON_ESSENTIAL_MODEL_CALLS=1
